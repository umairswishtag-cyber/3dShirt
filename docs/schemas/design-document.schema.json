{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/schemas/design-document.schema.json",
  "title": "Design Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "productId",
    "productDefinitionId",
    "productDefinitionVersion",
    "revision",
    "selection",
    "zonesById",
    "areasById",
    "objectsById",
    "groupsById"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "productId": { "$ref": "#/$defs/id" },
    "productDefinitionId": { "$ref": "#/$defs/id" },
    "productDefinitionVersion": { "type": "integer", "minimum": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "title": { "type": "string", "maxLength": 255 },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variantId", "quantity"],
      "properties": {
        "variantId": { "$ref": "#/$defs/id" },
        "size": { "type": "string", "maxLength": 64 },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "options": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" }
            ]
          }
        }
      }
    },
    "zonesById": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/zoneSelection" }
    },
    "areasById": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/areaDocument" }
    },
    "objectsById": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/designObject" }
    },
    "groupsById": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/group" }
    },
    "variables": {
      "type": "object",
      "default": {},
      "additionalProperties": {
        "anyOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "null" }
        ]
      }
    },
    "metadata": {
      "type": "object",
      "default": {},
      "additionalProperties": true
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
    },
    "zoneSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color"],
      "properties": {
        "color": { "$ref": "#/$defs/color" },
        "materialPresetId": { "$ref": "#/$defs/id" },
        "patternId": { "$ref": "#/$defs/id" },
        "patternParameters": { "type": "object", "additionalProperties": true }
      }
    },
    "areaDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectIds"],
      "properties": {
        "objectIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "backgroundColor": { "$ref": "#/$defs/color" }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xMm", "yMm", "rotationDeg", "scaleX", "scaleY"],
      "properties": {
        "xMm": { "type": "number" },
        "yMm": { "type": "number" },
        "rotationDeg": { "type": "number" },
        "scaleX": { "type": "number", "not": { "const": 0 } },
        "scaleY": { "type": "number", "not": { "const": 0 } },
        "skewXDeg": { "type": "number", "default": 0 },
        "skewYDeg": { "type": "number", "default": 0 }
      }
    },
    "shadow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "offsetXMm", "offsetYMm", "blurMm"],
      "properties": {
        "color": { "$ref": "#/$defs/color" },
        "offsetXMm": { "type": "number" },
        "offsetYMm": { "type": "number" },
        "blurMm": { "type": "number", "minimum": 0 }
      }
    },
    "gradientStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "color"],
      "properties": {
        "offset": { "type": "number", "minimum": 0, "maximum": 1 },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "paint": {
      "oneOf": [
        { "$ref": "#/$defs/color" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "angleDeg", "stops"],
          "properties": {
            "type": { "const": "linear-gradient" },
            "angleDeg": { "type": "number" },
            "stops": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/gradientStop" }
            }
          }
        }
      ]
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brightness": { "type": "number", "minimum": -1, "maximum": 1, "default": 0 },
        "contrast": { "type": "number", "minimum": -1, "maximum": 1, "default": 0 },
        "saturation": { "type": "number", "minimum": -1, "maximum": 1, "default": 0 }
      }
    },
    "baseObject": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "areaId",
        "name",
        "visible",
        "locked",
        "opacity",
        "transform",
        "widthMm",
        "heightMm"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string" },
        "areaId": { "$ref": "#/$defs/id" },
        "groupId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "transform": { "$ref": "#/$defs/transform" },
        "widthMm": { "type": "number", "exclusiveMinimum": 0 },
        "heightMm": { "type": "number", "exclusiveMinimum": 0 },
        "clipPathId": { "$ref": "#/$defs/id" }
      }
    },
    "imageObject": {
      "allOf": [
        { "$ref": "#/$defs/baseObject" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "assetId", "assetVariantId", "crop", "filters"],
          "properties": {
            "id": true,
            "kind": { "const": "image" },
            "areaId": true,
            "groupId": true,
            "name": true,
            "visible": true,
            "locked": true,
            "opacity": true,
            "transform": true,
            "widthMm": true,
            "heightMm": true,
            "clipPathId": true,
            "assetId": { "$ref": "#/$defs/id" },
            "assetVariantId": { "$ref": "#/$defs/id" },
            "crop": { "$ref": "#/$defs/crop" },
            "filters": { "$ref": "#/$defs/filters" },
            "maskObjectId": { "$ref": "#/$defs/id" }
          }
        }
      ]
    },
    "svgObject": {
      "allOf": [
        { "$ref": "#/$defs/baseObject" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "assetId", "assetVariantId"],
          "properties": {
            "id": true,
            "kind": { "const": "svg" },
            "areaId": true,
            "groupId": true,
            "name": true,
            "visible": true,
            "locked": true,
            "opacity": true,
            "transform": true,
            "widthMm": true,
            "heightMm": true,
            "clipPathId": true,
            "assetId": { "$ref": "#/$defs/id" },
            "assetVariantId": { "$ref": "#/$defs/id" },
            "colorOverrides": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/color" }
            }
          }
        }
      ]
    },
    "textObject": {
      "allOf": [
        { "$ref": "#/$defs/baseObject" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text",
            "fontId",
            "fontSizePt",
            "fontWeight",
            "fontStyle",
            "letterSpacingEm",
            "lineHeight",
            "align",
            "fill"
          ],
          "properties": {
            "id": true,
            "kind": { "const": "text" },
            "areaId": true,
            "groupId": true,
            "name": true,
            "visible": true,
            "locked": true,
            "opacity": true,
            "transform": true,
            "widthMm": true,
            "heightMm": true,
            "clipPathId": true,
            "text": { "type": "string", "maxLength": 10000 },
            "variableKey": { "type": "string", "maxLength": 128 },
            "fontId": { "$ref": "#/$defs/id" },
            "fontSizePt": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
            "fontWeight": { "type": "integer", "minimum": 100, "maximum": 900, "multipleOf": 100 },
            "fontStyle": { "enum": ["normal", "italic"] },
            "letterSpacingEm": { "type": "number", "minimum": -1, "maximum": 10 },
            "lineHeight": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
            "align": { "enum": ["left", "center", "right", "justify"] },
            "fill": { "$ref": "#/$defs/paint" },
            "outlineColor": { "$ref": "#/$defs/color" },
            "outlineWidthMm": { "type": "number", "minimum": 0 },
            "shadow": { "$ref": "#/$defs/shadow" },
            "pathEffect": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "amount"],
              "properties": {
                "type": { "enum": ["arc", "curve", "warp"] },
                "amount": { "type": "number", "minimum": -1, "maximum": 1 }
              }
            }
          }
        }
      ]
    },
    "codeObject": {
      "allOf": [
        { "$ref": "#/$defs/baseObject" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "format", "value", "foreground", "background"],
          "properties": {
            "id": true,
            "kind": { "const": "code" },
            "areaId": true,
            "groupId": true,
            "name": true,
            "visible": true,
            "locked": true,
            "opacity": true,
            "transform": true,
            "widthMm": true,
            "heightMm": true,
            "clipPathId": true,
            "format": { "enum": ["qr", "code128", "ean13", "upca"] },
            "value": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "foreground": { "$ref": "#/$defs/color" },
            "background": { "$ref": "#/$defs/color" },
            "errorCorrection": { "enum": ["L", "M", "Q", "H"] }
          }
        }
      ]
    },
    "shapeObject": {
      "allOf": [
        { "$ref": "#/$defs/baseObject" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "shape", "fill"],
          "properties": {
            "id": true,
            "kind": { "const": "shape" },
            "areaId": true,
            "groupId": true,
            "name": true,
            "visible": true,
            "locked": true,
            "opacity": true,
            "transform": true,
            "widthMm": true,
            "heightMm": true,
            "clipPathId": true,
            "shape": { "enum": ["rectangle", "ellipse", "polygon", "line", "path"] },
            "pathData": { "type": "string" },
            "fill": { "$ref": "#/$defs/paint" },
            "stroke": { "$ref": "#/$defs/color" },
            "strokeWidthMm": { "type": "number", "minimum": 0 }
          }
        }
      ]
    },
    "designObject": {
      "oneOf": [
        { "$ref": "#/$defs/imageObject" },
        { "$ref": "#/$defs/svgObject" },
        { "$ref": "#/$defs/textObject" },
        { "$ref": "#/$defs/codeObject" },
        { "$ref": "#/$defs/shapeObject" }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "areaId", "name", "objectIds", "transform"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "areaId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "objectIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "transform": { "$ref": "#/$defs/transform" }
      }
    }
  }
}
