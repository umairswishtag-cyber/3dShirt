<style>
  .shirt-configurator {
    display: block;
    width: 100vw;
    max-width: none;
    min-width: 0;
    overflow: clip;
  }

  .shirt-configurator__signin,
  .shirt-configurator__noscript {
    display: grid;
    min-height: 360px;
    place-content: center;
    padding: 2rem;
    text-align: center;
    background: #f8fafc;
  }

  .shirt-configurator__signin h2 {
    margin: 0;
    color: #0f172a;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .shirt-configurator__signin p {
    max-width: 38rem;
    margin: 1rem auto 1.5rem;
    color: #475569;
  }

  .shirt-configurator__signin a {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    justify-self: center;
    border-radius: 0.75rem;
    padding: 0.75rem 1.25rem;
    background: #0f172a;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }
</style>

<div
  id="shirt-configurator-{{ block.id }}"
  class="shirt-configurator"
  aria-label="{{ block.settings.title | escape }}"
  data-shirt-configurator-root
  data-customer-name="{{ customer.name | escape }}"
  data-customer-email="{{ customer.email | escape }}"
  data-login-url="{{ routes.storefront_login_url }}"
  data-stylesheet-url="https://umair.xoarhigh.info/build/shopify/configurator-embed.css?v=24"
>
  {% unless customer %}
    <div class="shirt-configurator__signin">
      <h2>{{ block.settings.signin_title | escape }}</h2>
      <p>{{ block.settings.signin_text | escape }}</p>
      <a href="{{ routes.storefront_login_url }}">
        {{ block.settings.signin_label | escape }}
      </a>
    </div>
  {% endunless %}

  <noscript>
    <p class="shirt-configurator__noscript">
      JavaScript is required to use the 3D configurator.
    </p>
  </noscript>
</div>

{% schema %}
{
  "name": "3D Configurator",
  "target": "section",
  "javascript": "configurator-loader.js",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Accessible title",
      "default": "3D product configurator"
    },
    {
      "type": "text",
      "id": "signin_title",
      "label": "Sign-in heading",
      "default": "Sign in to start designing"
    },
    {
      "type": "textarea",
      "id": "signin_text",
      "label": "Sign-in message",
      "default": "Use your Shopify customer account to open the configurator and keep all your saved designs together."
    },
    {
      "type": "text",
      "id": "signin_label",
      "label": "Sign-in button label",
      "default": "Sign in with Shopify"
    }
  ]
}
{% endschema %}
