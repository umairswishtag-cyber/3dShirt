{% liquid
  assign customized_count = 0
  for item in cart.items
    if item.properties['_3d_job_id'] != blank
      assign customized_count = customized_count | plus: 1
    endif
  endfor
%}

{% if customized_count > 0 or request.design_mode %}
  <section class="configurator-cart-details" aria-labelledby="configurator-cart-details-title-{{ block.id }}">
    <h2 id="configurator-cart-details-title-{{ block.id }}">{{ block.settings.heading | escape }}</h2>
    <p class="configurator-cart-details__intro">{{ block.settings.description | escape }}</p>

    {% if customized_count > 0 %}
      <div class="configurator-cart-details__items">
        {% for item in cart.items %}
          {% if item.properties['_3d_job_id'] != blank %}
            <article class="configurator-cart-details__item">
              <div>
                <h3>{{ item.product.title | escape }}</h3>
                {% unless item.product.has_only_default_variant %}
                  <p>{{ item.variant.title | escape }}</p>
                {% endunless %}
              </div>
              <dl>
                {% for property in item.properties %}
                  {% assign property_first_character = property.first | slice: 0 %}
                  {% unless property_first_character == '_' or property.last == blank %}
                    <div>
                      <dt>{{ property.first | escape }}</dt>
                      <dd>{{ property.last | escape }}</dd>
                    </div>
                  {% endunless %}
                {% endfor %}
              </dl>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="configurator-cart-details__editor-note">
        Editor preview: customer-facing design details appear here after a customized product is added to the cart.
      </div>
    {% endif %}
  </section>

  <style>
    .configurator-cart-details{margin:2rem auto;padding:1.5rem;max-width:1200px;border:1px solid rgba(15,23,42,.12);border-radius:1rem;background:#fff;color:#0f172a}
    .configurator-cart-details h2{margin:0;font-size:1.35rem}
    .configurator-cart-details__intro{margin:.4rem 0 0;color:#64748b}
    .configurator-cart-details__items{display:grid;gap:1rem;margin-top:1.25rem}
    .configurator-cart-details__item{display:grid;grid-template-columns:minmax(10rem,.7fr) minmax(0,2fr);gap:1.25rem;padding:1rem;border-radius:.75rem;background:#f8fafc}
    .configurator-cart-details__item h3,.configurator-cart-details__item p{margin:0}
    .configurator-cart-details__item p{margin-top:.25rem;color:#64748b}
    .configurator-cart-details__item dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:0}
    .configurator-cart-details__item dl div{min-width:0}
    .configurator-cart-details__item dt{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#64748b}
    .configurator-cart-details__item dd{margin:.2rem 0 0;overflow-wrap:anywhere}
    .configurator-cart-details__editor-note{margin-top:1.25rem;padding:1rem;border:1px dashed rgba(15,23,42,.2);border-radius:.75rem;background:#f8fafc;color:#64748b}
    @media(max-width:749px){.configurator-cart-details__item{grid-template-columns:1fr}.configurator-cart-details__item dl{grid-template-columns:1fr}}
  </style>
{% endif %}

{% schema %}
{
  "name": "3D design cart details",
  "target": "section",
  "enabled_on": {
    "templates": ["cart"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your custom print details"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "These details and the final production files are saved with each customized item."
    }
  ]
}
{% endschema %}
